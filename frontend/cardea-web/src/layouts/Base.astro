---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Pie from "../components/Pie.astro";

interface Props { title: string; description?: string; noindex?: boolean }
const {
  title,
  description = "Cardea gobierna el uso de IA en tu empresa: quién usa qué modelo, qué tools ejecuta, qué datos salen y cuánto cuesta por equipo. Instalado en tu infraestructura.",
  noindex = false,
} = Astro.props;
const site = Astro.site ?? new URL("https://cardea.tekhos.com");
const canonical = new URL(Astro.url.pathname, site).toString();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/img/og.png", site).toString()} />
    <meta name="theme-color" content="#12263A" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Pie />
  </body>
</html>
