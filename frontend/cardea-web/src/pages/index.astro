---
import Base from "../layouts/Base.astro";
import Formulario from "../components/Formulario.astro";

const preguntas = [
  { quien: "Finanzas no puede responder", q: "¿Cuánto gasta cada equipo y en qué?", d: "Cada proveedor factura aparte y nadie lo reparte por centro de coste." },
  { quien: "Seguridad no puede responder", q: "¿Qué datos de clientes han salido, y qué ha ejecutado un agente en nombre de quién?" },
  { quien: "Dirección técnica no puede responder", q: "¿Quién usa qué herramienta y qué modelo?", d: "Hay una consola distinta por herramienta y ninguna las suma." },
];

const controla = [
  { t: "Aplicaciones por API", d: "Pasan por el gateway. Reglas, límites de gasto y redacción de datos antes de llegar al proveedor." },
  { t: "CLIs de código", d: "Claude Code, Codex y Copilot con una clave por desarrollador emitida tras el SSO. El tráfico pasa por el mismo gateway." },
  { t: "Tools MCP remotas", d: "Lo que ejecutan los agentes: servidores aprobados, permiso por equipo y por tool, credenciales guardadas en el gateway y no en el portátil." },
];
const registra = { t: "Asientos y chat web", d: "No se pueden enrutar. Se leen las métricas de las consolas de cada proveedor para sumar uso y coste a la misma vista." };

const ventajas = [
  { t: "El coste, en el idioma de Finanzas", d: "Centro de coste, presupuesto por equipo con aviso y bloqueo, y una exportación de chargeback." },
  { t: "Los datos personales no salen", d: "DNI, IBAN, correos y nombres se sustituyen por marcadores antes de llegar al proveedor. El original no se guarda." },
  { t: "Un informe que dice lo que no cubre", d: "Evidencias por periodo para auditoría, con la cobertura declarada control por control." },
];

const pantallas = [
  { id: "panel", img: "/img/panel.webp", t: "Panel general", q: "¿Cómo va el mes y qué necesita una decisión hoy?", d: "Gasto frente a presupuesto, reparto por canal y una lista corta de lo que no puede esperar." },
  { id: "costes", img: "/img/costes.webp", t: "Costes y chargeback", q: "¿Cuánto gasta cada equipo, y en qué?", d: "Gasto por equipo, proyecto, modelo o herramienta, con centro de coste, aviso y bloqueo. Exportable a tu ERP." },
  { id: "politicas", img: "/img/politicas.webp", t: "Políticas", q: "¿Qué se comprueba antes de que una petición salga?", d: "Datos personales, modelos permitidos, tools MCP y límites de gasto. Cada regla se prueba con un texto antes de activarse." },
  { id: "actividad", img: "/img/actividad.webp", t: "Actividad y auditoría", q: "¿Qué ha pasado con esta petición?", d: "Cada petición y cada tool call con su decisión y su recorrido. El texto original no se almacena." },
  { id: "desarrolladores", img: "/img/desarrolladores.webp", t: "Desarrolladores y claves", q: "¿Quién usa qué herramienta, y con qué clave?", d: "Una clave por persona para todos sus CLIs, emitida tras el SSO, con caducidad y detección de claves sin uso." },
  { id: "evidencias", img: "/img/evidencias.webp", t: "Evidencias", q: "¿Qué puedo demostrar ante una auditoría?", d: "Un informe por periodo que declara qué controles cubre, cuáles en parte y cuáles no." },
  { id: "conexiones", img: "/img/conexiones.webp", t: "Conexiones", q: "¿Está llegando cada dato?", d: "Proveedores de modelos, collectors e identidad, con su estado y lo que hay que reconectar." },
];

const fuera = [
  { t: "Chat web fuera del SSO corporativo y control de las completions inline de Copilot", d: "Solo métricas agregadas." },
  { t: "Servidores MCP locales y tools internas de cada CLI", d: "No pasan por ningún gateway; se limitan con configuración gestionada en el puesto." },
  { t: "Seguridad ofensiva de agentes", d: "Inyección de prompts, tools envenenadas, sandbox. Para eso hay fabricantes de seguridad." },
  { t: "Alojamiento de modelos, workspace de chat para empleados y gestión de APIs", d: "Cardea es solo gobierno." },
];

const pasos = [
  { v: "Conecta", d: "proveedores de modelos, servidores MCP y tu SSO." },
  { v: "Apunta", d: "las aplicaciones y los CLIs al gateway; un cambio de URL y de clave." },
  { v: "Define", d: "presupuestos, datos a redactar, modelos y tools permitidos por equipo." },
  { v: "Reparte", d: "el coste y genera el informe de evidencias cada trimestre." },
];
---
<Base title="Cardea · Gobierno del uso de IA">
  <section class="hero">
    <div class="wrap">
      <h1>Quién usa qué modelo, cuánto cuesta y qué datos salen de la empresa, en una sola vista.</h1>
      <p class="lead">Un punto de control para las aplicaciones, los CLIs de código y las tools que ejecutan los agentes, con el coste repartido por equipo y un informe que un auditor puede leer. Instalado en tu infraestructura: los prompts no salen de tu red y no se almacenan.</p>
      <div class="cta">
        <a class="btn btn-primary" href="#demo">Pedir una demo</a>
        <a class="btn btn-ghost" href="#alcance">Qué cubre y qué no</a>
      </div>
      <figure class="shot">
        <img src="/img/panel.webp" width="2880" height="1800" alt="Panel general de Cardea con el gasto del mes, el reparto por canal y lo que requiere atención" loading="eager" fetchpriority="high" />
        <figcaption><span class="ilustrativo">Datos ilustrativos</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section alt" id="problema" aria-labelledby="problema-t">
    <div class="wrap partido">
      <h2 id="problema-t">Tres canales de uso y ninguna vista común</h2>
      <ol class="preguntas">
        {preguntas.map((p) => (
          <li>
            <h3>{p.quien}</h3>
            <div>
              <p class="q">{p.q}</p>
              {p.d && <p>{p.d}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="que-hace" aria-labelledby="que-hace-t">
    <div class="wrap">
      <h2 id="que-hace-t" class="ancho-titulo">Un punto de control para API, CLIs y tools MCP, y visibilidad sobre los asientos</h2>
      <div class="canales">
        <div class="grupo grupo-controla">
          <p class="grupo-t"><span>Controla y registra</span></p>
          <ul>
            {controla.map((c) => (
              <li><h3>{c.t}</h3><p>{c.d}</p></li>
            ))}
          </ul>
        </div>
        <div class="grupo grupo-registra">
          <p class="grupo-t"><span>Solo registra</span></p>
          <ul>
            <li><h3>{registra.t}</h3><p>{registra.d}</p></li>
          </ul>
        </div>
      </div>
      <ul class="ventajas">
        {ventajas.map((v) => (
          <li><h3>{v.t}</h3><p>{v.d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt" id="pantallas" aria-labelledby="pantallas-t">
    <div class="wrap">
      <h2 id="pantallas-t" class="ancho-titulo">Hecho para que lo lean Finanzas, Seguridad y Cumplimiento, no solo Plataforma</h2>

      <!-- Escritorio: la pregunta elige la pantalla. -->
      <div class="visor" data-visor>
        <div class="visor-lista" role="tablist" aria-orientation="vertical" aria-label="Pantallas del panel">
          {pantallas.map((p, i) => (
            <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`pan-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <span class="tab-t">{p.t}</span>
              <span class="tab-q">{p.q}</span>
            </button>
          ))}
        </div>
        <div class="visor-paneles">
          {pantallas.map((p, i) => (
            <figure role="tabpanel" id={`pan-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
              <img src={p.img} width="2880" height="1800" alt={`Pantalla de ${p.t}: ${p.d}`} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
              <figcaption><p>{p.d}</p><span class="ilustrativo">Datos ilustrativos</span></figcaption>
            </figure>
          ))}
        </div>
      </div>

      <!-- Móvil: las siete, una debajo de otra. -->
      <ol class="pila">
        {pantallas.map((p) => (
          <li>
            <h3>{p.t}</h3>
            <p class="pregunta">{p.q}</p>
            <img src={p.img} width="2880" height="1800" alt={`Pantalla de ${p.t}: ${p.d}`} loading="lazy" decoding="async" />
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
      <p class="pila-nota"><span class="ilustrativo">Datos ilustrativos</span></p>
    </div>
  </section>

  <section class="section" id="alcance" aria-labelledby="alcance-t">
    <div class="wrap partido">
      <div>
        <h2 id="alcance-t">Lo que Cardea no cubre, dicho antes de que lo preguntes</h2>
        <p class="lead">Preferimos que lo sepas en la primera reunión y no en la auditoría.</p>
      </div>
      <ul class="fuera">
        {fuera.map((f) => (
          <li><h3>{f.t}</h3><p>{f.d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark" id="instalacion" aria-labelledby="instalacion-t">
    <div class="wrap partido">
      <div>
        <h2 id="instalacion-t">En tu red, con tu identidad</h2>
        <p class="lead">El gateway y el motor de políticas corren en tu infraestructura: un chart de Helm en tu Kubernetes o en tu cuenta de AWS. Los prompts no pasan por servidores nuestros. Tu Entra ID u Okta emite las identidades; cada desarrollador recibe una clave propia válida para todos sus CLIs.</p>
      </div>
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li><span class="num" aria-hidden="true">{i + 1}</span><p><b>{p.v}</b> {p.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="demo" aria-labelledby="demo-t">
    <div class="wrap partido">
      <div>
        <h2 id="demo-t">Pide una demo con tu tráfico real</h2>
        <p class="lead">Desplegamos el MVP en tu cuenta con tus aplicaciones, tus CLIs y tu proveedor de identidad. Si no responde las tres preguntas en el primer mes, no se factura.</p>
      </div>
      <Formulario id="formulario-demo" />
    </div>
  </section>
</Base>

<script>
  // Visor de pantallas: pestañas verticales con flechas, Inicio y Fin (patrón ARIA de tabs).
  const visor = document.querySelector<HTMLElement>("[data-visor]");
  if (visor) {
    const tabs = Array.from(visor.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activar = (tab: HTMLButtonElement, foco = false) => {
      for (const t of tabs) {
        const sel = t === tab;
        t.setAttribute("aria-selected", String(sel));
        t.tabIndex = sel ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !sel;
      }
      if (foco) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activar(tab));
      tab.addEventListener("keydown", (e) => {
        const n = tabs.length;
        const teclas: Record<string, number> = { ArrowDown: (i + 1) % n, ArrowRight: (i + 1) % n, ArrowUp: (i - 1 + n) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 };
        const destino = teclas[e.key];
        if (destino === undefined) return;
        e.preventDefault();
        activar(tabs[destino], true);
      });
    });
  }
</script>

<style>
  /* Retícula de dos columnas asimétricas: título a la izquierda, contenido a la derecha. */
  .partido { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .ancho-titulo { max-width: 26ch; }
  @media (max-width: 900px) { .partido { grid-template-columns: 1fr; gap: 32px; } }

  /* Hero */
  .hero { padding: clamp(56px, 8vw, 104px) 0 0; overflow: hidden; }
  .hero h1 { max-width: 23ch; letter-spacing: -0.03em; line-height: 1.05; font-size: clamp(38px, 5.4vw, 66px); }
  .hero .lead { max-width: 58ch; }
  .cta { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
  .shot { margin-top: clamp(48px, 7vw, 80px); background: var(--cardea-niebla); border-radius: var(--radio) var(--radio) 0 0; padding: clamp(14px, 3vw, 40px) clamp(14px, 3vw, 40px) 0; }
  .shot img { border-radius: 14px 14px 0 0; box-shadow: var(--cardea-sombra); }
  .shot figcaption { padding: 12px 0 16px; }

  /* El problema: tres preguntas sin respuesta, como lista con filetes. */
  .preguntas { list-style: none; border-top: 1px solid var(--cardea-linea); }
  .preguntas li { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 8px 32px; padding: 28px 0; border-bottom: 1px solid var(--cardea-linea); }
  .preguntas h3 { font-size: 15px; font-weight: 600; letter-spacing: 0; line-height: 1.4; color: var(--cardea-petroleo); padding-top: 4px; }
  .preguntas .q { font-size: clamp(19px, 1.8vw, 22px); line-height: 1.35; font-weight: 500; color: var(--cardea-tinta); letter-spacing: -0.01em; }
  .preguntas .q + p { margin-top: 8px; }
  @media (max-width: 600px) { .preguntas li { grid-template-columns: 1fr; padding: 24px 0; } }

  /* Qué hace: los canales agrupados por lo que Cardea puede hacer con ellos. */
  .canales { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 32px; margin-top: 48px; }
  .grupo-t { position: relative; font-size: 14px; font-weight: 600; color: var(--cardea-tinta); padding-bottom: 14px; margin-bottom: 24px; }
  .grupo-t::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 8px; border: 2px solid var(--cardea-petroleo); border-bottom: 0; }
  .grupo-registra .grupo-t { color: var(--cardea-texto); }
  .grupo-registra .grupo-t::after { border-color: var(--cardea-texto-suave); border-style: dashed; }
  .grupo ul { list-style: none; display: grid; gap: 28px; }
  .grupo-controla ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grupo h3 { font-size: 18px; }
  .grupo p { font-size: 15.5px; margin-top: 8px; }
  @media (max-width: 1000px) {
    .canales { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 700px) {
    .grupo-controla ul { grid-template-columns: 1fr; }
  }
  .ventajas { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 32px; margin-top: clamp(48px, 6vw, 72px); padding-top: 32px; border-top: 1px solid var(--cardea-linea); }
  .ventajas h3 { font-size: 17px; }
  .ventajas p { font-size: 15.5px; margin-top: 8px; }
  @media (max-width: 800px) { .ventajas { grid-template-columns: 1fr; } }

  /* Pantallas: visor con la pregunta como índice (escritorio) y pila (móvil). */
  .visor { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: 40px; margin-top: 48px; align-items: start; }
  .visor-lista { display: flex; flex-direction: column; gap: 4px; }
  .visor-lista button {
    display: flex; flex-direction: column; gap: 3px; text-align: left; font: inherit; cursor: pointer;
    background: transparent; border: 0; border-radius: var(--radio-s); padding: 13px 16px; color: var(--cardea-texto);
    transition: background .15s ease, box-shadow .15s ease;
  }
  .visor-lista button:hover { background: rgba(255, 255, 255, .6); }
  .tab-t { font-size: 13.5px; font-weight: 600; color: var(--cardea-texto-suave); }
  .tab-q { font-size: 16px; line-height: 1.35; }
  .visor-lista button[aria-selected="true"] { background: #ffffff; box-shadow: 0 1px 0 var(--cardea-linea), 0 10px 24px -18px rgba(18, 38, 58, .5); }
  .visor-lista button[aria-selected="true"] .tab-t { color: var(--cardea-petroleo); }
  .visor-lista button[aria-selected="true"] .tab-q { color: var(--cardea-tinta); font-weight: 500; }
  .visor-paneles img { border-radius: 14px; box-shadow: 0 0 0 1px var(--cardea-linea), var(--cardea-sombra); }
  .visor-paneles figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; margin-top: 20px; }
  .visor-paneles figcaption p { max-width: 60ch; }
  .visor-paneles figcaption .ilustrativo { flex: none; }
  .pila, .pila-nota { display: none; }
  @media (max-width: 960px) {
    .visor { display: none; }
    .pila { display: flex; flex-direction: column; gap: 48px; list-style: none; margin-top: 36px; }
    .pila-nota { display: block; margin-top: 24px; }
    .pila h3 { font-size: 15px; font-weight: 600; letter-spacing: 0; color: var(--cardea-petroleo); }
    .pila .pregunta { font-size: 20px; line-height: 1.3; font-weight: 500; color: var(--cardea-tinta); margin-top: 4px; }
    .pila img { margin-top: 18px; border-radius: 10px; box-shadow: 0 0 0 1px var(--cardea-linea), var(--cardea-sombra); }
    .pila img + p { margin-top: 14px; }
  }

  /* Alcance */
  .fuera { list-style: none; border-top: 1px solid var(--cardea-linea); }
  .fuera li { padding: 22px 0; border-bottom: 1px solid var(--cardea-linea); }
  .fuera h3 { font-size: 17px; line-height: 1.35; letter-spacing: -0.01em; }
  .fuera p { margin-top: 6px; }

  /* Instalación: cuatro pasos en orden, unidos por una línea. */
  .pasos { list-style: none; display: flex; flex-direction: column; }
  .pasos li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 20px; padding-bottom: 28px; }
  .pasos li:last-child { padding-bottom: 0; }
  .pasos li:not(:last-child)::after { content: ""; position: absolute; left: 19px; top: 44px; bottom: 6px; width: 2px; background: var(--cardea-linea-tinta); }
  .pasos .num { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 2px var(--cardea-petroleo-claro); color: var(--cardea-petroleo-claro); font-weight: 600; font-size: 15px; }
  .pasos p { font-size: 17px; line-height: 1.5; padding-top: 8px; }
  .pasos b { color: #ffffff; font-weight: 600; }
</style>
