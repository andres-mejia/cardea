---
import Isotipo from "./Isotipo.astro";
interface Props { size?: number; dark?: boolean; href?: string; label?: string; animate?: boolean }
const { size = 28, dark = false, href = "/", label = "Cardea", animate = false } = Astro.props;
---
<a href={href} class="marca" aria-label={label} style={`--s:${size}px;color:${dark ? "#fff" : "var(--cardea-tinta)"}`}>
  {animate
    ? <span class="iso" transition:persist="gozne"><Isotipo size={size} dark={dark} animate /></span>
    : <span class="iso"><Isotipo size={size} dark={dark} /></span>}<span>Cardea</span>
</a>
<style>
  .marca { display: inline-flex; align-items: center; gap: calc(var(--s) * 0.32); font-weight: 600; letter-spacing: -0.02em; font-size: calc(var(--s) * 0.82); line-height: 1; border-radius: 8px; }
  .iso { display: block; }
</style>
