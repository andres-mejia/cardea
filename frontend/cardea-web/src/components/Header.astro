---
import Marca from "./Marca.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "https://cardea-app.tekhos.com";
---
<header class="hdr">
  <div class="wrap row">
    <Marca size={30} />
    <nav aria-label="Secciones">
      <a href="#que-hace">Qué hace</a>
      <a href="#pantallas">Pantallas</a>
      <a href="#alcance">Alcance</a>
      <a href="#instalacion">Instalación</a>
    </nav>
    <div class="acciones">
      <a class="btn btn-ghost" href={appUrl}>Entrar</a>
      <a class="btn btn-primary" href="#demo">Pedir una demo</a>
    </div>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.86); backdrop-filter: blur(10px); border-bottom: 1px solid var(--cardea-linea); }
  .row { display: flex; align-items: center; gap: 28px; height: 68px; }
  nav { display: flex; gap: 6px; font-size: 15px; color: var(--cardea-texto); margin-left: 8px; }
  nav a { padding: 10px 10px; border-radius: 8px; }
  nav a:hover { color: var(--cardea-tinta); background: var(--cardea-niebla); }
  .acciones { margin-left: auto; display: flex; gap: 8px; }
  .acciones .btn { min-height: 44px; padding: 10px 18px; font-size: 14.5px; }
  @media (max-width: 860px) { nav { display: none; } .row { gap: 12px; } .acciones .btn { padding: 10px 14px; } }
  @media (max-width: 360px) { .acciones .btn-ghost { box-shadow: none; padding: 10px 8px; } }
</style>
