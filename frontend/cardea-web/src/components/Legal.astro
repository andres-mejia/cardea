---
import Base from "../layouts/Base.astro";
import { t, path, withRoutes, type Lang, type LegalKey } from "../i18n";
interface Props { lang: Lang; page: LegalKey }
const { lang, page } = Astro.props;
const d = t(lang);
const doc = d.legal.pages[page];
const otras = (["privacy", "terms", "notice", "cookies"] as const).filter((k) => k !== page);
---
<Base lang={lang} route={page} title={`${doc.title} · Cardea`} description={doc.description}>
  <article class="section">
    <div class="wrap doc">
      <a class="volver" href={path("home", lang)}>
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M16 10H5M9 5.5 4.5 10 9 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {d.legal.back}
      </a>
      <h1>{doc.title}</h1>
      <p class="fecha">{d.legal.updated}</p>
      <div class="legal">
        {doc.sections.map((s) => (
          <section>
            <h2>{s.h}</h2>
            <Fragment set:html={s.body.map((b) => withRoutes(b, lang)).join("")} />
          </section>
        ))}
      </div>
      <nav class="otras" aria-label={d.legal.others}>
        <p>{d.legal.others}</p>
        <ul>
          {otras.map((k) => <li><a href={path(k, lang)}>{d.legal.pages[k].title}</a></li>)}
        </ul>
      </nav>
    </div>
  </article>
</Base>
<style>
  .doc { max-width: 760px; }
  .volver { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; color: var(--cardea-petroleo); padding: 10px 0; margin-bottom: 20px; }
  .volver:hover { text-decoration: underline; text-underline-offset: 4px; }
  h1 { font-size: clamp(34px, 4.4vw, 48px); letter-spacing: -0.03em; }
  .fecha { margin-top: 14px; font-size: 15px; color: var(--cardea-texto-suave); }
  .legal { margin-top: 8px; font-size: 17px; line-height: 1.65; max-width: 68ch; }
  .otras { margin-top: 56px; padding: 24px; border-radius: 16px; background: var(--cardea-niebla); }
  .otras p { font-size: 14px; font-weight: 600; color: var(--cardea-tinta); }
  .otras ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 6px; }
  .otras a { display: inline-block; padding: 8px 0; color: var(--cardea-petroleo); font-weight: 500; text-underline-offset: 4px; }
  .otras a:hover { text-decoration: underline; }
</style>
