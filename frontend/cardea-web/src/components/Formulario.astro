---
/**
 * Formulario para pedir una demo. Contrato del backend (infra/modules/waitlist), no cambiar:
 * POST JSON a PUBLIC_WAITLIST_ENDPOINT con `nombre`, `email`, `empresa` (opcional) y
 * `uso` ("", "api", "clis", "asientos" o "todo"). Sin endpoint, simula el envío para maquetar en local.
 */
import { t, path, type Lang } from "../i18n";
interface Props { id?: string; lang: Lang }
const { id = "formulario-demo", lang } = Astro.props;
const d = t(lang).form;
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? "";
---
<form class="f" id={id} novalidate data-form data-endpoint={endpoint}
  data-err-name={d.errName} data-err-email-empty={d.errEmailEmpty} data-err-email={d.errEmail}
  data-err-summary={d.errSummary} data-sending={d.sending} data-fail={d.fail}>
  <div class="campos" data-campos>
    <div class="campo">
      <label for={`${id}-nombre`}>{d.name}</label>
      <input class="in" id={`${id}-nombre`} type="text" name="nombre" autocomplete="name" required maxlength="120" aria-describedby={`${id}-nombre-err`} />
      <p class="err" id={`${id}-nombre-err`} data-err></p>
    </div>
    <div class="campo">
      <label for={`${id}-email`}>{d.email}</label>
      <input class="in" id={`${id}-email`} type="email" name="email" autocomplete="email" inputmode="email" required maxlength="200" spellcheck="false" aria-describedby={`${id}-email-err`} />
      <p class="err" id={`${id}-email-err`} data-err></p>
    </div>
    <div class="campo ancho">
      <label for={`${id}-empresa`}>{d.company} <span class="opc">({d.optional})</span></label>
      <input class="in" id={`${id}-empresa`} type="text" name="empresa" autocomplete="organization" maxlength="160" />
    </div>
    <fieldset class="campo ancho uso">
      <legend>{d.usage} <span class="opc">({d.optional})</span></legend>
      <div class="chips">
        {d.usageOptions.map((o) => (
          <label class="chip">
            <input type="radio" name="uso" value={o.v} />
            <span>{o.t}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <div class="enviar" data-enviar>
    <button class="btn btn-primary" type="submit" data-submit>
      <span data-submit-t>{d.submit}</span>
      <svg class="flecha" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <p class="nota">{d.note}</p>
  </div>
  <p class="estado" data-estado role="status" aria-live="polite"></p>
  <p class="priv">{d.privacy} <a href={path("privacy", lang)}>{d.privacyLink}</a>.</p>

  <div class="ok" data-ok hidden tabindex="-1">
    <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="var(--cardea-petroleo)" /><path d="M12.5 20.5 18 26l10-11" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <div>
      <p class="ok-t">{d.okTitle}</p>
      <p>{d.ok}</p>
      <button type="button" class="otra" data-otra>{d.again}</button>
    </div>
  </div>
</form>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  function iniciar() {
    const form = document.querySelector<HTMLFormElement>("[data-form]");
    if (!form || form.dataset.listo) return;
    form.dataset.listo = "1";
    const ds = form.dataset;
    const nombre = form.elements.namedItem("nombre") as HTMLInputElement;
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const empresa = form.elements.namedItem("empresa") as HTMLInputElement;
    const estado = form.querySelector<HTMLElement>("[data-estado]")!;
    const boton = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const botonT = form.querySelector<HTMLElement>("[data-submit-t]")!;
    const textoBoton = botonT.textContent;
    const ok = form.querySelector<HTMLElement>("[data-ok]")!;
    const bloques = [form.querySelector<HTMLElement>("[data-campos]")!, form.querySelector<HTMLElement>("[data-enviar]")!, form.querySelector<HTMLElement>(".priv")!];

    const error = (c: HTMLInputElement) => {
      const v = c.value.trim();
      if (c === nombre) return v ? "" : ds.errName!;
      if (c === email) return !v ? ds.errEmailEmpty! : EMAIL.test(v) ? "" : ds.errEmail!;
      return "";
    };
    const marcar = (c: HTMLInputElement, msg: string) => {
      const p = document.getElementById(c.getAttribute("aria-describedby")!)!;
      p.textContent = msg;
      if (msg) c.setAttribute("aria-invalid", "true"); else c.removeAttribute("aria-invalid");
    };
    // Validación en línea: al salir del campo; y, si ya estaba marcado, mientras se corrige.
    // Si el foco sale porque se pulsa Enviar, no se marca aquí: el aviso movería el botón bajo el dedo
    // y el clic se perdería. El envío valida todo.
    let pulsando = false;
    boton.addEventListener("pointerdown", () => { pulsando = true; setTimeout(() => (pulsando = false), 800); });
    for (const c of [nombre, email]) {
      c.addEventListener("blur", () => { if (!pulsando && (c.value.trim() || c.hasAttribute("aria-invalid"))) marcar(c, error(c)); });
      c.addEventListener("input", () => { if (c.hasAttribute("aria-invalid")) marcar(c, error(c)); });
    }
    // Los chips son radios que se pueden desmarcar: el uso es opcional.
    form.querySelectorAll<HTMLInputElement>('input[name="uso"]').forEach((r) => {
      let estaba = false;
      r.addEventListener("pointerdown", () => { estaba = r.checked; });
      r.addEventListener("click", () => { if (estaba) { r.checked = false; estaba = false; } });
      r.addEventListener("keydown", (e) => { if ((e.key === " " || e.key === "Enter") && r.checked) { e.preventDefault(); r.checked = false; } });
    });

    const avisar = (texto: string, tipo: "error" | "") => { estado.textContent = texto; estado.dataset.tipo = tipo; };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const malos = [nombre, email].filter((c) => { const m = error(c); marcar(c, m); return Boolean(m); });
      if (malos.length) { avisar(ds.errSummary!, "error"); malos[0].focus(); return; }
      const uso = (form.querySelector<HTMLInputElement>('input[name="uso"]:checked')?.value) ?? "";
      const datos = { nombre: nombre.value.trim(), email: email.value.trim(), empresa: empresa.value.trim(), uso };
      boton.disabled = true; form.setAttribute("aria-busy", "true"); botonT.textContent = ds.sending!; avisar("", "");
      try {
        const endpoint = ds.endpoint;
        if (endpoint) {
          const r = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(datos) });
          if (!r.ok) throw new Error(String(r.status));
        } else {
          await new Promise((res) => setTimeout(res, 600));
        }
        form.reset();
        bloques.forEach((b) => (b.hidden = true));
        ok.hidden = false;
        ok.focus();
      } catch {
        avisar(ds.fail!, "error");
      } finally {
        boton.disabled = false; form.removeAttribute("aria-busy"); botonT.textContent = textoBoton;
      }
    });
    form.querySelector("[data-otra]")!.addEventListener("click", () => {
      ok.hidden = true;
      bloques.forEach((b) => (b.hidden = false));
      nombre.focus();
    });
  }
  document.addEventListener("astro:page-load", iniciar);
</script>

<style>
  .f { display: flex; flex-direction: column; gap: 20px; background: var(--cardea-niebla); border-radius: var(--radio); padding: clamp(22px, 3.2vw, 36px); }
  .campos { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; }
  .campos[hidden], .enviar[hidden], .priv[hidden] { display: none; }
  .campo { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
  .ancho { grid-column: 1 / -1; }
  label, legend { font-size: 14.5px; font-weight: 500; color: var(--cardea-tinta); }
  .opc { font-weight: 400; color: var(--cardea-texto-suave); }
  .in {
    font: inherit; font-size: 16px; min-height: 50px; padding: 12px 14px; border-radius: var(--radio-s);
    border: 1px solid var(--cardea-borde-campo); background: #fff; color: var(--cardea-tinta); min-width: 0; width: 100%; /* taste-skill-ignore: campo de formulario */
    transition: border-color var(--t-hover) ease, box-shadow var(--t-hover) ease; /* taste-skill-ignore: campo de formulario */
  }
  .in:hover { border-color: var(--cardea-texto); }
  .in:focus-visible { outline: none; border-color: var(--cardea-petroleo); box-shadow: 0 0 0 3px rgba(10, 111, 125, .22); } /* taste-skill-ignore: campo de formulario */
  .in[aria-invalid="true"] { border-color: var(--estado-bloqueada); box-shadow: inset 0 0 0 1px var(--estado-bloqueada); } /* taste-skill-ignore: campo de formulario */
  .err { font-size: 13.5px; color: var(--estado-bloqueada); font-weight: 500; }
  .err:empty { display: none; }

  fieldset { border: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: 9px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; cursor: pointer; font-weight: 400; }
  .chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 16px; border-radius: 999px; font-size: 15px;
    background: #ffffff; color: var(--cardea-tinta); box-shadow: inset 0 0 0 1px var(--cardea-linea); /* taste-skill-ignore: campo de formulario */
    transition: background-color var(--t-hover) ease, box-shadow var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out); /* taste-skill-ignore: campo de formulario */
  }
  .chip span::before { content: ""; width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--cardea-borde-campo); background: #fff; transition: box-shadow var(--t-hover) ease, background-color var(--t-hover) ease; flex: none; } /* taste-skill-ignore: campo de formulario */
  .chip:hover span { box-shadow: inset 0 0 0 1px var(--cardea-borde-campo); } /* taste-skill-ignore: campo de formulario */
  .chip:active span { transform: scale(.98); }
  .chip input:checked + span { background: #e3f1f3; box-shadow: inset 0 0 0 1.5px var(--cardea-petroleo); color: var(--cardea-tinta); font-weight: 500; } /* taste-skill-ignore: campo de formulario */
  .chip input:checked + span::before { background: var(--cardea-petroleo); box-shadow: inset 0 0 0 4px #fff, 0 0 0 1.5px var(--cardea-petroleo); } /* taste-skill-ignore: campo de formulario */
  .chip input:focus-visible + span { outline: 2px solid var(--cardea-petroleo); outline-offset: 2px; }

  .enviar { display: flex; align-items: center; gap: 12px 20px; flex-wrap: wrap; }
  .enviar .btn { min-height: 52px; padding: 14px 24px; font-size: 16px; }
  .nota { font-size: 14px; color: var(--cardea-texto-suave); }
  .estado:empty { display: none; }
  .estado { font-size: 15px; font-weight: 500; color: var(--cardea-tinta); }
  .estado[data-tipo="error"] { color: var(--estado-bloqueada); }
  .priv { font-size: 13px; color: var(--cardea-texto-suave); margin-top: -6px; }
  .priv a { text-decoration: underline; text-underline-offset: 3px; }
  .priv a:hover { color: var(--cardea-tinta); }

  .ok { display: flex; gap: 16px; align-items: flex-start; padding: 8px 0; outline: none; }
  .ok[hidden] { display: none; }
  .ok svg { flex: none; }
  .ok-t { font-size: 22px; font-weight: 600; color: var(--cardea-tinta); letter-spacing: -0.01em; }
  .ok p + p { margin-top: 4px; }
  .otra { margin-top: 14px; font: inherit; font-size: 15px; font-weight: 500; color: var(--cardea-petroleo); background: none; border: 0; padding: 10px 0; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .ok:not([hidden]) { animation: aparece 360ms var(--ease-out); }
    .ok:not([hidden]) circle { animation: punto 420ms var(--ease-out); transform-box: fill-box; transform-origin: center; }
  }
  @keyframes aparece { from { opacity: 0; transform: translateY(8px); } }
  @keyframes punto { from { transform: scale(.4); opacity: 0; } }

  @media (max-width: 560px) {
    .campos { grid-template-columns: 1fr; }
    .enviar .btn { width: 100%; }
  }
</style>
