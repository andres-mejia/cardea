---
/**
 * Símbolo «Gozne» (ADR-001): la C del nombre y el punto del gozne.
 * Con `animate`, la C se traza como una puerta que gira y el punto aparece al final (una vez, al cargar).
 */
interface Props { size?: number; dark?: boolean; class?: string; animate?: boolean }
const { size = 28, dark = false, class: cls = "", animate = false } = Astro.props;
const ink = dark ? "#FFFFFF" : "var(--cardea-tinta)";
const dot = dark ? "var(--cardea-petroleo-claro)" : "var(--cardea-petroleo)";
---
<svg viewBox="0 0 96 96" width={size} height={size} class:list={["gozne", cls, { "gozne-anim": animate }]} aria-hidden="true">
  <path class="gozne-c" pathLength="1" d="M 72 72 A 34 34 0 1 1 72 24" style={`fill:none;stroke:${ink};stroke-width:11;stroke-linecap:butt`} />
  <circle class="gozne-p" cx="48" cy="48" r="10" style={`fill:${dot}`} />
</svg>
<style>
  .gozne { display: block; flex: none; overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .gozne-anim .gozne-c { stroke-dasharray: 1; stroke-dashoffset: 1; animation: gozne-trazo 900ms cubic-bezier(0.65, 0, 0.35, 1) 120ms forwards; }
    .gozne-anim .gozne-p { transform-box: fill-box; transform-origin: center; transform: scale(.4); opacity: 0; animation: gozne-punto 420ms cubic-bezier(0.16, 1, 0.3, 1) 860ms forwards; }
  }
  @keyframes gozne-trazo { to { stroke-dashoffset: 0; } }
  @keyframes gozne-punto { to { transform: scale(1); opacity: 1; } }
</style>
