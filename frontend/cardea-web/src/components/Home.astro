---
import Base from "../layouts/Base.astro";
import Formulario from "./Formulario.astro";
import Flujo from "./Flujo.astro";
import Carrusel from "./Carrusel.astro";
import { t, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang} route="home" title={d.meta.home.title} description={d.meta.home.description}>
  <section class="hero" aria-labelledby="hero-t">
    <div class="wrap">
      <div class="hero-texto">
        <h1 id="hero-t" class="entra" style="--i:0">{d.hero.title}</h1>
        <div class="hero-pie">
          <p class="lead entra" style="--i:1">{d.hero.lead}</p>
          <div class="cta entra" style="--i:2">
            <a class="btn btn-primary" href="#demo">{d.hero.primary}<svg class="flecha" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <a class="btn btn-ghost" href="#alcance">{d.hero.secondary}</a>
          </div>
        </div>
      </div>
      <div class="hero-flujo entra" style="--i:3">
        <Flujo lang={lang} />
      </div>
    </div>
  </section>

  <section class="section alt" id="problema" aria-labelledby="problema-t">
    <div class="wrap partido">
      <h2 id="problema-t" data-reveal>{d.problem.title}</h2>
      <ol class="preguntas">
        {d.problem.items.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{p.who}</h3>
            <div>
              <p class="q">{p.q}</p>
              {p.d && <p>{p.d}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="que-hace" aria-labelledby="que-hace-t">
    <div class="wrap">
      <h2 id="que-hace-t" class="ancho-titulo" data-reveal>{d.what.title}</h2>
      <div class="canales">
        <div class="grupo grupo-controla" data-reveal style="--i:1">
          <p class="grupo-t"><span>{d.what.controls}</span></p>
          <ul>
            {d.what.control.map((c) => (
              <li><h3>{c.t}</h3><p>{c.d}</p></li>
            ))}
          </ul>
        </div>
        <div class="grupo grupo-registra" data-reveal style="--i:2">
          <p class="grupo-t"><span>{d.what.records}</span></p>
          <ul>
            <li><h3>{d.what.record.t}</h3><p>{d.what.record.d}</p></li>
          </ul>
        </div>
      </div>
      <ul class="ventajas">
        {d.what.benefits.map((v, i) => (
          <li data-reveal style={`--i:${i}`}><h3>{v.t}</h3><p>{v.d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt" id="pantallas" aria-labelledby="pantallas-t">
    <div class="wrap">
      <h2 id="pantallas-t" class="ancho-titulo" data-reveal>{d.screens.title}</h2>
      <Carrusel lang={lang} />
    </div>
  </section>

  <section class="section" id="alcance" aria-labelledby="alcance-t">
    <div class="wrap partido">
      <div data-reveal>
        <h2 id="alcance-t">{d.scope.title}</h2>
        <p class="lead">{d.scope.lead}</p>
      </div>
      <ul class="fuera">
        {d.scope.items.map((f, i) => (
          <li data-reveal style={`--i:${i}`}><h3>{f.t}</h3><p>{f.d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark" id="instalacion" aria-labelledby="instalacion-t">
    <div class="wrap partido">
      <div data-reveal>
        <h2 id="instalacion-t">{d.install.title}</h2>
        <p class="lead">{d.install.lead}</p>
      </div>
      <ol class="pasos">
        {d.install.steps.map((p, i) => (
          <li data-reveal style={`--i:${i}`}><span class="num" aria-hidden="true">{i + 1}</span><p><b>{p.v}</b> {p.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="demo" aria-labelledby="demo-t">
    <div class="wrap partido">
      <div data-reveal>
        <h2 id="demo-t">{d.demo.title}</h2>
        <p class="lead">{d.demo.lead}</p>
      </div>
      <div data-reveal style="--i:1">
        <Formulario lang={lang} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Retícula de dos columnas asimétricas: título a la izquierda, contenido a la derecha. */
  .partido { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .ancho-titulo { max-width: 26ch; }
  @media (max-width: 900px) { .partido { grid-template-columns: 1fr; gap: 32px; } }

  /* Hero: titular en dos líneas, entrada escalonada y el flujo como pieza principal. */
  .hero { padding: clamp(48px, 7vw, 88px) 0 clamp(56px, 8vw, 104px); }
  .hero h1 { max-width: 16em; letter-spacing: -0.035em; line-height: 1.02; font-size: clamp(40px, 5.6vw, 78px); }
  .hero-pie { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 48px; align-items: end; margin-top: 28px; }
  .hero .lead { max-width: 60ch; margin-top: 0; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-flujo { margin-top: clamp(40px, 5vw, 64px); }
  @media (max-width: 1000px) { .hero-pie { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .cta .btn { flex: 1 1 100%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .entra { animation: entra 560ms var(--ease-out) both; animation-delay: calc(var(--i, 0) * 90ms + 80ms); }
    .hero-flujo.entra { animation-duration: 720ms; }
  }
  @keyframes entra { from { opacity: 0; transform: translateY(16px); } }

  /* El problema: tres preguntas sin respuesta, como lista. */
  .preguntas { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .preguntas li { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 8px 32px; padding: 24px 24px; border-radius: 16px; background: #ffffff; }
  .preguntas h3 { font-size: 15px; font-weight: 600; letter-spacing: 0; line-height: 1.4; color: var(--cardea-petroleo); padding-top: 4px; }
  .preguntas .q { font-size: clamp(19px, 1.8vw, 22px); line-height: 1.35; font-weight: 500; color: var(--cardea-tinta); letter-spacing: -0.01em; }
  .preguntas .q + p { margin-top: 8px; }
  @media (max-width: 600px) { .preguntas li { grid-template-columns: 1fr; padding: 20px; } }

  /* Qué hace: los canales agrupados por lo que Cardea puede hacer con ellos. */
  .canales { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 32px; margin-top: 48px; }
  .grupo-t { position: relative; font-size: 14px; font-weight: 600; color: var(--cardea-tinta); padding-bottom: 14px; margin-bottom: 24px; }
  .grupo-t::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 8px; border: 2px solid var(--cardea-petroleo); border-bottom: 0; border-radius: 4px 4px 0 0; }
  .grupo-registra .grupo-t { color: var(--cardea-texto); }
  .grupo-registra .grupo-t::after { border-color: var(--cardea-texto-suave); border-style: dashed; }
  .grupo ul { list-style: none; display: grid; gap: 28px; }
  .grupo-controla ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grupo h3 { font-size: 18px; }
  .grupo p { font-size: 15.5px; margin-top: 8px; }
  @media (max-width: 1000px) { .canales { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 700px) { .grupo-controla ul { grid-template-columns: 1fr; } }
  .ventajas { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: clamp(48px, 6vw, 72px); }
  .ventajas li { background: var(--cardea-niebla); border-radius: 16px; padding: 24px; }
  .ventajas h3 { font-size: 17px; }
  .ventajas p { font-size: 15.5px; margin-top: 8px; }
  @media (max-width: 800px) { .ventajas { grid-template-columns: 1fr; } }

  /* Alcance */
  .fuera { list-style: none; display: flex; flex-direction: column; }
  .fuera li { padding: 22px 0; box-shadow: 0 -1px 0 var(--cardea-linea); } /* taste-skill-ignore: separa cláusulas de alcance */
  .fuera li:last-child { box-shadow: 0 -1px 0 var(--cardea-linea), 0 1px 0 var(--cardea-linea); } /* taste-skill-ignore: idem */
  .fuera h3 { font-size: 17px; line-height: 1.35; letter-spacing: -0.01em; }
  .fuera p { margin-top: 6px; }

  /* Instalación: cuatro pasos en orden, unidos por una línea. */
  .pasos { list-style: none; display: flex; flex-direction: column; }
  .pasos li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 20px; padding-bottom: 28px; }
  .pasos li:last-child { padding-bottom: 0; }
  .pasos li:not(:last-child)::after { content: ""; position: absolute; left: 19px; top: 44px; bottom: 6px; width: 2px; background: var(--cardea-linea-tinta); }
  .pasos .num { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--cardea-petroleo-claro); color: var(--cardea-tinta); font-weight: 600; font-size: 15px; }
  .pasos p { font-size: 17px; line-height: 1.5; padding-top: 8px; }
  .pasos b { color: #ffffff; font-weight: 600; }
</style>
