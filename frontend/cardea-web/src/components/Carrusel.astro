---
/**
 * Pase de las siete pantallas del panel (patrón WAI-ARIA de carrusel con pestañas).
 * Avanza solo cada 6 s con fundido y un paneo lento, como un vídeo de producto; se pausa al pasar el
 * ratón o el foco, con el botón de pausa o al tocar los controles. Teclado en las pestañas, swipe en móvil.
 * Con movimiento reducido no avanza solo. Sin script, se ve la primera pantalla y la lista funciona como índice.
 */
import { t, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const s = d.screens;
const n = s.items.length;
const alt = (p: (typeof s.items)[number]) => s.alt.replace("{t}", p.t).replace("{d}", p.d);
---
<section class="car" data-car aria-roledescription={s.roledescription} aria-label={s.carousel}>
  <div class="car-grid">
    <div class="car-lista" role="tablist" aria-label={s.list} aria-orientation="vertical">
      {s.items.map((p, i) => (
        <button type="button" role="tab" id={`car-tab-${p.id}`} aria-controls={`car-pan-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-label={`${p.t}: ${p.q}`}>
          <span class="tab-t">{p.t}</span>
          <span class="tab-q">{p.q}</span>
          <span class="tab-barra" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <div class="car-vista">
      <div class="car-marco" data-marco>
        {s.items.map((p, i) => (
          <figure class:list={["car-pan", { activa: i === 0 }]} role="tabpanel" id={`car-pan-${p.id}`} aria-labelledby={`car-tab-${p.id}`} aria-roledescription={s.slideRole} data-pan>
            <div class="car-img" data-ui>
              <img src={`/img/${p.id}.webp`} width="2880" height="1800" alt={alt(p)} loading={i === 0 ? "eager" : "lazy"} decoding="async" draggable="false" />
            </div>
            <figcaption>
              <span class="pan-t">{p.t}</span>
              <span class="pan-q">{p.q}</span>
              <span class="pan-d">{p.d}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="car-ctrl">
        <div class="botones">
          <button type="button" class="ctl" data-prev aria-label={s.prev}>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
          </button>
          <button type="button" class="ctl ctl-play" data-play aria-label={s.pause} data-label-pause={s.pause} data-label-play={s.play}>
            <svg class="i-pausa" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7 4.5v11M13 4.5v11" /></svg>
            <svg class="i-play" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M6.5 4.2v11.6L16 10z" class="relleno" /></svg>
          </button>
          <button type="button" class="ctl" data-next aria-label={s.next}>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
          </button>
          <p class="cuenta" aria-hidden="true"><span data-n>1</span> / {n}</p>
        </div>
        <span class="ilustrativo">{d.ui.illustrative}</span>
      </div>
      <p class="sr-only" data-anuncio aria-live="off" aria-atomic="true"></p>
    </div>
  </div>
</section>

<script>
  const INTERVALO = 6000;
  let parar: (() => void) | undefined;

  function iniciar() {
    parar?.();
    const raiz = document.querySelector<HTMLElement>("[data-car]");
    if (!raiz) return;
    const car: HTMLElement = raiz;
    const tabs = Array.from(car.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const pans = Array.from(car.querySelectorAll<HTMLElement>("[data-pan]"));
    const marco = car.querySelector<HTMLElement>("[data-marco]")!;
    const play = car.querySelector<HTMLButtonElement>("[data-play]")!;
    const contador = car.querySelector<HTMLElement>("[data-n]")!;
    const anuncio = car.querySelector<HTMLElement>("[data-anuncio]")!;
    const n = tabs.length;
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let actual = 0;
    let reproduciendo = !quieto; // el usuario puede pausarlo; ratón o foco solo lo suspenden
    let suspendido = false;
    let visible = false;
    let timer = 0;

    car.classList.add("js");
    pans.forEach((p, i) => { p.inert = i !== 0; });

    function mostrar(i: number, foco = false, anunciar = false) {
      actual = (i + n) % n;
      tabs.forEach((t, k) => {
        const sel = k === actual;
        t.setAttribute("aria-selected", String(sel));
        t.tabIndex = sel ? 0 : -1;
      });
      pans.forEach((p, k) => {
        const sel = k === actual;
        p.classList.toggle("activa", sel);
        p.inert = !sel;
      });
      contador.textContent = String(actual + 1);
      if (anunciar) anuncio.textContent = `${actual + 1} / ${n}: ${tabs[actual].getAttribute("aria-label")}`;
      if (foco) tabs[actual].focus();
      // Precarga la siguiente para que el fundido no espere a la red.
      const sig = pans[(actual + 1) % n].querySelector("img");
      if (sig && sig.loading === "lazy") sig.loading = "eager";
      programar();
    }

    function programar() {
      clearTimeout(timer);
      const corre = reproduciendo && !suspendido && visible && !document.hidden;
      car.dataset.corre = corre ? "1" : "0";
      // Reinicia la barra de progreso de la pestaña activa.
      car.classList.remove("tick"); void car.offsetWidth; if (corre) car.classList.add("tick");
      if (corre) timer = window.setTimeout(() => mostrar(actual + 1), INTERVALO);
    }

    function fijarReproduccion(v: boolean) {
      reproduciendo = v;
      play.setAttribute("aria-label", v ? play.dataset.labelPause! : play.dataset.labelPlay!);
      car.dataset.estado = v ? "play" : "pausa";
      // Mientras rota, los cambios no se anuncian; en pausa, sí.
      anuncio.setAttribute("aria-live", v ? "off" : "polite");
      programar();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => { fijarReproduccion(false); mostrar(i, false, true); });
      tab.addEventListener("keydown", (e) => {
        const teclas: Record<string, number> = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: n - 1 };
        if (!(e.key in teclas)) return;
        e.preventDefault();
        fijarReproduccion(false);
        mostrar(teclas[e.key], true, true);
      });
    });
    car.querySelector("[data-prev]")!.addEventListener("click", () => { fijarReproduccion(false); mostrar(actual - 1, false, true); });
    car.querySelector("[data-next]")!.addEventListener("click", () => { fijarReproduccion(false); mostrar(actual + 1, false, true); });
    play.addEventListener("click", () => fijarReproduccion(!reproduciendo));

    // Ratón encima o foco dentro: se suspende sin cambiar la preferencia del usuario.
    const suspender = (v: boolean) => { suspendido = v; programar(); };
    car.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") suspender(true); });
    car.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") suspender(false); });
    car.addEventListener("focusin", () => suspender(true));
    car.addEventListener("focusout", (e) => { if (!car.contains(e.relatedTarget as Node)) suspender(false); });

    // Swipe horizontal en táctil.
    let x0 = 0, y0 = 0, arrastrando = false;
    marco.addEventListener("pointerdown", (e) => { if (e.pointerType === "mouse") return; x0 = e.clientX; y0 = e.clientY; arrastrando = true; });
    marco.addEventListener("pointerup", (e) => {
      if (!arrastrando) return; arrastrando = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) { fijarReproduccion(false); mostrar(actual + (dx < 0 ? 1 : -1), false, true); }
    });
    marco.addEventListener("pointercancel", () => { arrastrando = false; });

    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; programar(); }, { threshold: 0.25 });
    io.observe(car);
    const vis = () => programar();
    document.addEventListener("visibilitychange", vis);

    fijarReproduccion(reproduciendo);
    parar = () => { clearTimeout(timer); io.disconnect(); document.removeEventListener("visibilitychange", vis); };
  }

  document.addEventListener("astro:page-load", iniciar);
  document.addEventListener("astro:before-swap", () => { parar?.(); parar = undefined; });
</script>

<style>
  .car { margin-top: 48px; }
  .car-grid { display: grid; grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); gap: 40px; align-items: start; }

  /* Índice de preguntas: elige la pantalla; la activa lleva una barra que se llena mientras rota. */
  .car-lista { display: flex; flex-direction: column; gap: 4px; }
  .car-lista button {
    position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 3px; text-align: left; font: inherit; cursor: pointer;
    background: transparent; border: 0; border-radius: var(--radio-s); padding: 13px 16px 15px; color: var(--cardea-texto);
    transition: background-color var(--t-hover) ease;
  }
  .car-lista button:hover { background: rgba(255, 255, 255, .6); }
  .tab-t { font-size: 13.5px; font-weight: 600; color: var(--cardea-texto-suave); transition: color var(--t-hover) ease; }
  .tab-q { font-size: 16px; line-height: 1.35; transition: color var(--t-hover) ease; }
  .car-lista button[aria-selected="true"] { background: #ffffff; }
  .car-lista button[aria-selected="true"] .tab-t { color: var(--cardea-petroleo); }
  .car-lista button[aria-selected="true"] .tab-q { color: var(--cardea-tinta); font-weight: 500; }
  .tab-barra { position: absolute; left: 16px; right: 16px; bottom: 7px; height: 2px; border-radius: 2px; background: var(--cardea-niebla-2); transform-origin: left; opacity: 0; }
  .tab-barra::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--cardea-petroleo); transform: scaleX(0); transform-origin: left; }
  .car[data-corre="1"] [aria-selected="true"] .tab-barra { opacity: 1; }
  .car.tick [aria-selected="true"] .tab-barra::after { animation: llenar 6000ms linear forwards; }
  @keyframes llenar { to { transform: scaleX(1); } }

  /* Marco: las pantallas apiladas; la activa entra con fundido y un paneo lento. */
  .car-marco { position: relative; display: grid; border-radius: 16px; overflow: hidden; background: #fff; touch-action: pan-y; }
  .car-pan { grid-area: 1 / 1; display: flex; flex-direction: column; }
  .car-img[data-ui] { overflow: hidden; aspect-ratio: 16 / 10; background: var(--cardea-niebla); box-shadow: inset 0 -1px 0 rgba(18, 38, 58, .08); }
  .car-img img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .car-pan figcaption { display: none; }
  .car.js .car-pan { opacity: 0; visibility: hidden; transition: opacity 600ms var(--ease-out), visibility 0s linear 600ms; }
  .car.js .car-pan.activa { opacity: 1; visibility: visible; transition: opacity 600ms var(--ease-out), visibility 0s; z-index: 1; }
  .car:not(.js) .car-pan:not(:first-child) { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .car.js .car-pan .car-img img { transform: scale(1.045) translate(.8%, .6%); transition: transform 900ms var(--ease-out); }
    .car.js .car-pan.activa .car-img img { transform: scale(1.0) translate(0, 0); transition: transform 7000ms cubic-bezier(0.25, 0.1, 0.25, 1); }
  }

  .car-ctrl { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; margin-top: 18px; }
  .botones { display: flex; align-items: center; gap: 6px; }
  .ctl {
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 0; cursor: pointer; font: inherit;
    background: #fff; color: var(--cardea-tinta);
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .ctl:hover { background: var(--cardea-niebla-2); }
  .ctl:active { transform: scale(.94); }
  .ctl svg path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ctl svg path.relleno { fill: currentColor; stroke-width: 1.2; }
  .ctl-play { background: var(--cardea-tinta); color: #fff; }
  .ctl-play:hover { background: var(--cardea-tinta-2); }
  .i-play { display: none; }
  .car[data-estado="pausa"] .i-play { display: block; }
  .car[data-estado="pausa"] .i-pausa { display: none; }
  .car:not(.js) .car-ctrl .botones { display: none; }
  .cuenta { font-size: 14px; font-weight: 500; color: var(--cardea-texto-suave); margin-left: 8px; min-width: 3.5em; }

  /* Escritorio: la descripción de la pantalla activa bajo la imagen. */
  @media (min-width: 961px) {
    .car-marco { overflow: visible; background: transparent; }
    .car-img[data-ui] { border-radius: 16px; box-shadow: 0 0 0 1px rgba(18, 38, 58, .1), var(--cardea-sombra); }
    .car-pan figcaption { display: block; padding-top: 20px; max-width: 62ch; }
    .car-pan .pan-t, .car-pan .pan-q { display: none; }
    .car-pan .pan-d { color: var(--cardea-texto); font-size: 16px; }
    .car-ctrl { margin-top: 12px; }
  }

  /* Móvil y tableta: la imagen arriba, la pregunta debajo y puntos en vez del índice. */
  @media (max-width: 960px) {
    .car-grid { grid-template-columns: 1fr; gap: 0; }
    .car-lista { order: 3; flex-direction: row; justify-content: center; gap: 0; margin-top: 4px; }
    .car-lista button { width: 40px; height: 40px; padding: 0; display: grid; place-items: center; background: transparent !important; }
    .car-lista button::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--cardea-borde-campo); transition: width var(--t-ui) var(--ease-out), background-color var(--t-hover) ease; }
    .car-lista button[aria-selected="true"]::before { width: 22px; border-radius: 999px; background: var(--cardea-petroleo); }
    .tab-t, .tab-q, .tab-barra { display: none; }
    .car-vista { display: contents; }
    .car-marco { order: 1; }
    .car-pan figcaption { display: flex; flex-direction: column; gap: 4px; padding: 18px 18px 20px; }
    .pan-t { font-size: 13.5px; font-weight: 600; color: var(--cardea-petroleo); }
    .pan-q { font-size: 19px; line-height: 1.3; font-weight: 500; color: var(--cardea-tinta); letter-spacing: -0.01em; }
    .pan-d { font-size: 15px; color: var(--cardea-texto); margin-top: 4px; }
    .car-ctrl { order: 2; margin-top: 14px; }
  }
</style>
